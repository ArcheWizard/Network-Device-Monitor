{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Network Device Monitor API Examples",
  "description": "Request/response examples for all API endpoints",
  "examples": {
    "health_check": {
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/health",
        "headers": {}
      },
      "response": {
        "status": 200,
        "body": {
          "status": "ok"
        }
      },
      "curl": "curl -X GET http://localhost:8000/api/health"
    },
    "list_devices": {
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/devices",
        "headers": {}
      },
      "response": {
        "status": 200,
        "body": [
          {
            "id": "aa:bb:cc:dd:ee:ff",
            "ip": "192.168.1.1",
            "mac": "aa:bb:cc:dd:ee:ff",
            "hostname": "router.local",
            "vendor": "Cisco Systems",
            "device_type": null,
            "status": "up",
            "first_seen": 1699000000,
            "last_seen": 1699001000,
            "tags": {
              "source": "arp"
            }
          },
          {
            "id": "11:22:33:44:55:66",
            "ip": "192.168.1.100",
            "mac": "11:22:33:44:55:66",
            "hostname": "laptop.local",
            "vendor": "Apple Inc",
            "device_type": null,
            "status": "up",
            "first_seen": 1699000100,
            "last_seen": 1699001100,
            "tags": {
              "source": "arp"
            }
          }
        ]
