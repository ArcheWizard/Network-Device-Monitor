    },
    "discovery_scan_minimal": {
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/api/discovery/scan",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "count": 3,
          "devices": [
            {
              "ip": "192.168.1.1",
              "mac": "aa:bb:cc:dd:ee:ff",
              "hostname": "router.local",
              "vendor": "Cisco Systems",
